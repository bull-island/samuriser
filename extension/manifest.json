{
  "manifest_version": 3,
  "name": "Video Summariser",
  "version": "0.3.6",
  "description": "Adds videos and articles to your local Summariser with a right-click.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Save to Summariser" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shared.js", "youtube.js", "youtube_menu.js"],
      "css": ["card.css"],
      "run_at": "document_idle"
    }
  ]
}
